# ──────────────────────────────────────────────
# Archivist Configuration
# Copy to .env and fill in values.
# NEVER commit .env or real keys.
# ──────────────────────────────────────────────

# ── Model providers (set at least one) ────────
# Selection: ARCHIVIST_PROVIDER → OpenRouter → Anthropic → OpenAI

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional: force provider (openai | anthropic | openrouter)
# ARCHIVIST_PROVIDER=openai

# Model id for the chosen provider
# OpenAI:     gpt-4o  |  gpt-4o-mini
# Anthropic:  claude-sonnet-4-20250514
# OpenRouter: provider/model ids from openrouter.ai
ARCHIVIST_MODEL=gpt-4o-mini
# Optional: separate model for the review agent (defaults to ARCHIVIST_MODEL)
# ARCHIVIST_REVIEW_MODEL=gpt-4o
# ARCHIVIST_PROVIDER=openai

# ARCHIVIST_EMBEDDING_MODEL=text-embedding-3-small

# ── GitHub App (automatic PR reviews) ─────────
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Optional PAT for memory:bootstrap rate limits (use a fine-scoped token)
# GITHUB_TOKEN=

# ARCHIVIST_BOOTSTRAP_ON_INSTALL=true
# ARCHIVIST_SKIP_DOCS_ONLY=false
# ARCHIVIST_DATA_DIR=

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Review tuning
# ARCHIVIST_MAX_COMMENTS=8
# ARCHIVIST_CHUNK_CONCURRENCY=2

# Review prompt profile: strict | balanced | security | mentor | minimal | custom
# ARCHIVIST_PROMPT_PROFILE=balanced
# ARCHIVIST_CUSTOM_PROMPT=./my-review-prompt.txt

# ARCHIVIST_MIN_CONFIDENCE=0.6
# ARCHIVIST_REQUEST_CHANGES=false
