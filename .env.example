# ──────────────────────────────────────────────
# Archivist Configuration
# Copy to .env and fill in values
# ──────────────────────────────────────────────

# ── Model providers (set at least one) ────────
# Selection: ARCHIVIST_PROVIDER (if set) → OpenRouter → Anthropic → OpenAI

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional: force a provider
# ARCHIVIST_PROVIDER=openai
# ARCHIVIST_PROVIDER=anthropic
# ARCHIVIST_PROVIDER=openrouter

# Model id for the chosen provider
# OpenAI:     gpt-4o  |  gpt-4o-mini
# Anthropic:  claude-sonnet-4-20250514  |  claude-opus-4-20250514
# OpenRouter: any OpenRouter model id (including free-tier models)
ARCHIVIST_MODEL=gpt-4o-mini

# Embeddings (used when an embedding-capable route is configured)
# ARCHIVIST_EMBEDDING_MODEL=text-embedding-3-small

# ── GitHub App (automatic PR reviews) ─────────
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Optional: PAT for memory:bootstrap / higher API rate limits
# GITHUB_TOKEN=

# Optional
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DATABASE_URL=
# ARCHIVIST_DATA_DIR=

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
