# ──────────────────────────────────────────────
# Archivist Configuration
# Copy to .env and fill in values
# ──────────────────────────────────────────────

# OpenRouter (required for reviews — free models available)
OPENROUTER_API_KEY=
ARCHIVIST_MODEL=google/gemini-2.0-flash-exp:free
# ARCHIVIST_EMBEDDING_MODEL=openai/text-embedding-3-small

# GitHub App (required for automatic PR reviews)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Optional
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DATABASE_URL=
# ARCHIVIST_DATA_DIR=

NODE_ENV=development
PORT=3000

# Logging: debug | info | warn | error
LOG_LEVEL=info
