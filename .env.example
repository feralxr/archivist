# ──────────────────────────────────────────────
# Archivist Configuration
# Copy to .env and fill in values
# ──────────────────────────────────────────────

# ── Model provider (set at least one) ─────────
# Priority if multiple are set: ARCHIVIST_PROVIDER → OpenRouter → Anthropic → OpenAI

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: force a provider
# ARCHIVIST_PROVIDER=openrouter
# ARCHIVIST_PROVIDER=anthropic
# ARCHIVIST_PROVIDER=openai

# Model id for the chosen provider
# OpenRouter (default free): recursive/flint-v1.0:free
# Anthropic: claude-sonnet-4-20250514  |  claude-opus-4-20250514
# OpenAI:    gpt-4o  |  gpt-4o-mini
ARCHIVIST_MODEL=recursive/flint-v1.0:free

# Embeddings (OpenRouter model id, used when OPENROUTER_API_KEY is set)
# ARCHIVIST_EMBEDDING_MODEL=openai/text-embedding-3-small

# ── GitHub App (automatic PR reviews) ─────────
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Optional
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DATABASE_URL=
# ARCHIVIST_DATA_DIR=

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
