# Archivist Configuration
# Copy this file to .env and fill in the values

# OpenRouter (recommended - supports free models)
OPENROUTER_API_KEY=

# Optional: Direct provider keys (if not using OpenRouter)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# GitHub App (for the review bot)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Optional: Database (Postgres + pgvector recommended)
DATABASE_URL=

# Runtime
NODE_ENV=development
PORT=3000
