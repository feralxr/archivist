{
  "name": "@feralxr/archivist",
  "version": "0.4.0",
  "description": "Memory-aware code review for GitHub \u2014 high-signal PR reviews that learn your codebase",
  "type": "module",
  "bin": {
    "archivist": "bin/archivist.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "dev:server": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "start:server": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"lint not configured yet\"",
    "test": "tsx scripts/test-all.ts",
    "test:core": "ARCHIVIST_SKIP_LIVE=1 tsx scripts/test-all.ts",
    "test:live": "tsx scripts/test-all.ts",
    "docker:build": "docker build -t archivist .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "eval": "tsx scripts/eval.ts",
    "prepare": "node -e \"try{require('child_process').execSync('npx tsc',{stdio:'inherit'})}catch(e){console.log('(build skipped)')}\"",
    "prepublishOnly": "npm run typecheck && npm run build",
    "archivist": "node bin/archivist.js"
  },
  "keywords": [
    "code-review",
    "ai",
    "github-app",
    "developer-tools",
    "pull-request",
    "codebase-memory",
    "openrouter",
    "cli",
    "docker"
  ],
  "author": "feralxr",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@octokit/app": "^15.1.0",
    "@octokit/rest": "^21.0.2",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "ink": "^5.0.1",
    "openai": "^4.67.3",
    "react": "^18.3.1",
    "zod": "^3.23.8",
    "tsx": "^4.19.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "typescript": "^5.6.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feralxr/archivist.git"
  },
  "bugs": {
    "url": "https://github.com/feralxr/archivist/issues"
  },
  "homepage": "https://github.com/feralxr/archivist#readme",
  "files": [
    "bin/",
    "dist/",
    "src/",
    "docs/",
    "fixtures/",
    "package.json",
    "README.md",
    "LICENSE",
    "tsconfig.json",
    ".env.example"
  ],
  "publishConfig": {
    "access": "public"
  }
}
